        <mxCell id="c107" value="RecordWriter được triển khai bởi:&lt;br&gt;• NoOpsRecordWriter — không ghi&lt;br&gt;• UnsafeRecordWriter — không khóa toàn record&lt;br&gt;• SynchronizedRecordWriter — synchronized&lt;br&gt;• LockRecordWriter — ReentrantLock&lt;br&gt;Các lớp này được lược khỏi hình để tránh dày sơ đồ." parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff6d5;strokeColor=#b59b49;fontSize=15;align=left;spacing=12;">
          <mxGeometry as="geometry" x="1870" y="400" width="520" height="180" />
        </mxCell>
        <mxCell id="c108" parent="1" source="c107" target="c76" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;endArrow=none;strokeWidth=2;strokeColor=#0f172a;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c109" value="Pipeline ở 3 mode đồng thời:&lt;br&gt;Tạo 1 RecordProducer và N RecordConsumer.&lt;br&gt;Hai bên giữ cùng queue ArrayBlockingQueue(1000).&lt;br&gt;Producer và consumer implements Runnable (JDK).&lt;br&gt;BUFFERED/UNBUFFERED chỉ đếm; không dùng writer.&lt;br&gt;Lược bỏ dependency tạo worker để đường nối rõ hơn." parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff6d5;strokeColor=#b59b49;fontSize=15;align=left;spacing=12;">
          <mxGeometry as="geometry" x="1870" y="1350" width="520" height="175" />
        </mxCell>
        <mxCell id="c110" value="Ký hiệu UML&lt;br&gt;+ public; - private; # protected&lt;br&gt;Gạch chân: static; chữ nghiêng: abstract&lt;br&gt;Tam giác rỗng nét liền: generalization (extends)&lt;br&gt;Tam giác rỗng nét đứt: realization (implements)&lt;br&gt;Nét liền: association; số ở nhãn là multiplicity&lt;br&gt;Thoi đặc phía chủ sở hữu: composition&lt;br&gt;Nét đứt mũi tên mở: dependency&lt;br&gt;«record»: trường private final; accessor sinh tự động." parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff6d5;strokeColor=#b59b49;fontSize=15;align=left;spacing=12;">
          <mxGeometry as="geometry" x="1870" y="1640" width="520" height="280" />
        </mxCell>
        <mxCell id="c111" value="Phạm vi: cấu trúc chính, không liệt kê mọi getter/constructor. Các lớp phụ ProcessorFactory, WordCounter, WriteHelper và writer khác giữ nguyên trong source.&lt;br&gt;LargeFileGenerator sinh dữ liệu thử; lời gọi Main.genFile() hiện bị comment.&lt;br&gt;Lỗi source: cả 3 processor đồng thời gọi createResult(totalRecords, totalWords) — đảo ý nghĩa tham số, dẫn đến báo cáo đảo số dòng/từ." parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff6d5;strokeColor=#b59b49;fontSize=15;align=left;spacing=12;">
          <mxGeometry as="geometry" x="80" y="2380" width="2310" height="90" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>